{
  "name": "orbis-hotels-group",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"vite\" \"node server/index.js\"",
    "dev:web": "vite",
    "dev:api": "node server/index.js",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "start": "node server/index.js",
    "plan:regions": "node scripts/generate-plan/build-regions.mjs",
    "plan:pdfs": "node scripts/generate-plan/generate.mjs",
    "marcas:pdfs": "npx esbuild src/lib/brandLogos.ts --bundle --format=esm --outfile=scripts/brand-logo-svg.mjs --platform=neutral && node scripts/generate-brand-pdfs.mjs",
    "constructor:pdf": "node scripts/generate-constructor-pdf.mjs",
    "build:offline": "node scripts/build-offline.mjs",
    "pack:juego": "npm run build:offline && rm -f orbis-hotels-group-juego.zip && (cd offline && zip -r -9 ../orbis-hotels-group-juego.zip .)",
    "release:juego": "npm run pack:juego"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.9",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "fflate": "^0.8.3",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "pdfkit": "^0.19.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-leaflet": "^5.0.0",
    "uuid": "^14.0.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^24.13.3",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.4",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
